@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Заявка на кредит онлайн — C4 Container, в течение года после MVP
SHOW_PERSON_OUTLINE()
LAYOUT_TOP_DOWN()

Person(client, "Клиент", "Действующий клиент интернет-банка")
Person(visitor, "Посетитель сайта", "Существующие и новые клиенты")
Person(creditStaff, "Кредитный сотрудник", "Рассматривает заявки и принимает решения")
Person(branchStaff, "Сотрудник отделения", "Идентифицирует клиента и оформляет кредит")
Person(support, "Сотрудник сопровождения", "Контролирует незавершённые заявки")

System_Boundary(ib, "Интернет-банк") {
    Container(web, "Веб-интерфейс", "Существующая платформа + новый раздел", "Кредитные предложения, параметры заявки, СМС-подтверждение и статусы")
    Container(core, "Существующее серверное приложение", "Текущая платформа", "Аутентификация, клиентский контекст и существующие функции")
    Container(credits, "Сервис кредитных заявок", "Новый сервис", "Предложения, заявки, согласия, подтверждения, статусы и уведомления")
    ContainerDb(creditDb, "База кредитного сервиса", "MS SQL", "Заявки, версии предложений, согласия, подтверждения, статусы, inbox/outbox")
}

Boundary(integration, "Интеграционный контур") {
    ContainerQueue(kafka, "Kafka", "Существующий брокер сообщений", "Передача кредитных заявок, предложений и результатов обработки")
    Container(adapter, "Интеграционный адаптер АБС", "Расширение существующего сервиса", "Поиск онлайн-заявок, передача статусов, ограничение нагрузки и сверка результатов")
    ContainerDb(adapterDb, "Хранилище адаптера", "MS SQL", "Прогресс доставки, дедупликация и незавершённые операции")
    Container(creditAdapter, "Адаптер Кредитного конвейера", "Новый сервис", "Передача онлайн-заявок, получение предложений и решений, повторы и сверка")
}

System_Boundary(abs, "АБС") {
    Container(absApp, "Приложение АБС", "Существующая платформа + доработка", "Поиск и продолжение онлайн-заявки, идентификация, договор и выдача кредита")
    ContainerDb(absDb, "База данных АБС", "Существующая СУБД", "Заявки, одобрения, договоры, счета и учётные данные")
}

System_Ext(pipeline, "Кредитный конвейер", "Общие и персональные предложения, рассмотрение заявок и решения")
System_Ext(scoring, "Система скоринга", "Предварительная и упрощённая повторная оценка")
System_Ext(bki, "БКИ", "Кредитная история")
System_Ext(site, "Публичный сайт", "Общие кредитные предложения и форма онлайн-заявки")
System_Ext(sms, "СМС-шлюз", "Доставка кодов и уведомлений")

Rel(client, web, "Работает с кредитными предложениями и заявками", "HTTPS")
Rel(web, core, "Вход и существующие функции", "HTTPS")
Rel(web, credits, "Предложения, заявка, код и статус", "HTTPS")
Rel(credits, core, "Проверяет доверенный контекст клиента", "Защищённый интерфейс")
Rel(credits, creditDb, "Читает и сохраняет данные", "SQL")

Rel(visitor, site, "Смотрит предложения, заполняет заявку и согласия", "HTTPS")
Rel(site, credits, "Получает общие предложения и передаёт заявки", "Защищённый API")

Rel(credits, kafka, "Публикует принятые заявки")
Rel(kafka, creditAdapter, "Доставляет заявки")
Rel(creditAdapter, pipeline, "Передаёт заявки; получает предложения, решения и статусы", "Новый защищённый интерфейс")
Rel(creditAdapter, kafka, "Публикует предложения и результаты рассмотрения")
Rel(creditAdapter, adapterDb, "Сохраняет прогресс обмена", "SQL")
Rel(kafka, credits, "Доставляет предложения, решения и статусы АБС")

Rel(creditStaff, pipeline, "Рассматривает заявки и фиксирует решения")
Rel(pipeline, scoring, "Инициирует предварительную или повторную оценку")
Rel(scoring, bki, "Запрашивает кредитную историю при наличии согласия", "Защищённый интерфейс")

Rel(branchStaff, absApp, "Находит заявку, идентифицирует клиента и оформляет кредит")
Rel(absApp, adapter, "Запрашивает поиск онлайн-заявки", "Поддерживаемый интерфейс АБС")
Rel(adapter, credits, "Находит заявку для продолжения в отделении", "Защищённый API")
Rel(adapter, absApp, "Получает статусы оформления и результаты выдачи", "Поддерживаемый интерфейс АБС")
Rel(adapter, adapterDb, "Сохраняет прогресс обмена", "SQL")
Rel(adapter, kafka, "Публикует подтверждённые статусы и результаты АБС")

Rel(pipeline, absApp, "Передаёт одобрения", "Существующий суточный обмен")
Rel(absApp, absDb, "Читает и изменяет учётные данные", "SQL")

Rel(credits, sms, "Инициирует отправку кодов подтверждения и уведомлений", "Защищённый API")
Rel(support, credits, "Проверяет заявки и инициирует восстановление", "Защищённый интерфейс сопровождения")

SHOW_LEGEND()
@enduml