@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Заявка на кредит онлайн — C4 Context, в течение года после MVP
SHOW_PERSON_OUTLINE()
LAYOUT_TOP_DOWN()

Person(client, "Клиент", "Действующий клиент интернет-банка")
Person(visitor, "Посетитель сайта", "Существующие и новые клиенты")
Person(creditStaff, "Кредитный сотрудник", "Рассматривает заявки и принимает решения")
Person(branchStaff, "Сотрудник отделения", "Идентифицирует клиента и оформляет кредит")
Person(support, "Сотрудник сопровождения", "Контролирует незавершённые заявки")

Enterprise_Boundary(bank, "Банк «Стандарт»") {
    System(ib, "Интернет-банк", "Персональные предложения, подача и сопровождение кредитной заявки")
    System_Ext(site, "Публичный сайт Банка", "Общие кредитные предложения и подача заявки")
    System_Ext(pipeline, "Кредитный конвейер", "Кредитные условия, предодобренные предложения и рассмотрение заявок")
    System_Ext(scoring, "Система скоринга", "Предварительная и повторная оценка клиента")
    System_Ext(abs, "АБС", "Продолжение заявки в отделении, договор и выдача кредита")
    System_Ext(sms, "СМС-шлюз", "Доставка кодов подтверждения и уведомлений")
}

System_Ext(bki, "БКИ", "Кредитная история")

Rel(client, ib, "Выбирает предложение, подтверждает заявку, получает статус")
Rel(visitor, site, "Смотрит предложения, подаёт заявку и согласия")

Rel(pipeline, ib, "Публикует общие и персональные предложения")
Rel(site, pipeline, "Получает общие предложения; передаёт заявки", "Через интеграционный контур")
Rel(ib, pipeline, "Передаёт заявки; получает решения и статусы", "Асинхронный обмен через интеграционный контур")

Rel(pipeline, scoring, "Инициирует предварительную или упрощённую повторную оценку")
Rel(scoring, bki, "Запрашивает кредитную историю при наличии согласия")

Rel(creditStaff, pipeline, "Рассматривает заявки и фиксирует решения")
Rel(branchStaff, abs, "Находит заявку, идентифицирует клиента и оформляет кредит")
Rel(abs, pipeline, "Находит онлайн-заявку для продолжения оформления", "Через интеграционный контур")
Rel(pipeline, abs, "Передаёт одобрения", "Существующий суточный обмен")
Rel(abs, ib, "Передаёт статус оформления и результат выдачи", "Через интеграционный контур")

Rel(ib, sms, "Инициирует отправку кодов подтверждения и уведомлений")
Rel(site, sms, "Инициирует уведомления о результате и дальнейших действиях", "Через интеграционный контур")

Rel(support, ib, "Контролирует и восстанавливает обработку онлайн-заявок")

SHOW_LEGEND()
@enduml