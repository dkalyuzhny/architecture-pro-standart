@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Открытие депозитов онлайн — C4 Container, MVP
SHOW_PERSON_OUTLINE()
LAYOUT_TOP_DOWN()

Person(client, "Клиент", "Действующий клиент интернет-банка (после идентификации в отделении банка)")
Person(visitor, "Посетитель сайта", "Существующие и новые клиенты")
Person(callManager, "Менеджер кол-центра", "Обрабатывает обращения")
Person(depositStaff, "Депозитный бэк-офис", "Подтверждает условия и открывает депозит")
Person(rateStaff, "Сотрудники бэк-офисов", "Депозитный и кредитный бэк-офисы")
Person(support, "Сотрудник сопровождения", "Контролирует незавершённые заявки")

System_Boundary(ib, "Интернет-банк") {
    Container(web, "Веб-интерфейс", "Существующая платформа + новый раздел", "Предложения, параметры заявки, СМС-подтверждение и статусы")
    Container(core, "Существующее серверное приложение", "Текущая платформа", "Аутентификация, клиентский контекст и существующие функции")
    Container(deposits, "Сервис депозитных заявок", "Новый сервис", "Предложения, заявки, подтверждения, статусы и уведомления")
    ContainerDb(depositDb, "База депозитного сервиса", "MS SQL", "Заявки, версии условий, подтверждения, статусы, inbox/outbox")
}

Boundary(integration, "Интеграционный контур") {
    ContainerQueue(kafka, "Kafka", "Брокер сообщений", "Передача заявок, ставок и результатов обработки")
    Container(adapter, "Интеграционный адаптер АБС", "Новый сервис", "Преобразование, ограничение нагрузки, повторы и сверка результатов")
    ContainerDb(adapterDb, "Хранилище адаптера", "MS SQL", "Прогресс доставки, дедупликация и незавершённые операции")
}

System_Boundary(abs, "АБС") {
    Container(absApp, "Приложение АБС", "Существующая платформа", "Интерфейс сотрудников, обработка заявок, договоры, счета и проводки")
    ContainerDb(absDb, "База данных АБС", "Существующая СУБД", "Принятые заявки, решения, договоры, счета и учётные данные")
}

System_Ext(rates, "Реестр депозитных ставок", "Общие и персональные условия; версии и история изменений")
System_Ext(site, "Публичный сайт", "Общие предложения и форма обратного звонка")
System_Ext(callCenter, "Система кол-центра", "Обращения и предложенные индивидуальные условия")
System_Ext(sms, "СМС-шлюз", "Доставка кодов и уведомлений")

Rel(client, web, "Работает с депозитами", "HTTPS")
Rel(web, core, "Вход и существующие функции", "HTTPS")
Rel(web, deposits, "Предложения, заявка, код и статус", "HTTPS")
Rel(deposits, core, "Проверяет доверенный контекст клиента", "Защищённый интерфейс")
Rel(deposits, depositDb, "Читает и сохраняет данные", "SQL")

Rel(rates, kafka, "Публикует версии общих и персональных условий", "Защищённое соединение")
Rel(kafka, deposits, "Доставляет условия и результаты АБС")
Rel(deposits, kafka, "Публикует подтверждённые заявки")
Rel(kafka, adapter, "Доставляет заявки")
Rel(adapter, adapterDb, "Сохраняет прогресс обмена", "SQL")

Rel(adapter, absApp, "Передаёт заявки; получает статусы и результаты", "Поддерживаемый интерфейс АБС")
Rel(adapter, kafka, "Публикует подтверждённые результаты АБС")
Rel(depositStaff, absApp, "Подтверждает условия и открывает депозит")
Rel(absApp, absDb, "Читает и изменяет учётные данные", "SQL")

Rel(deposits, sms, "Отправляет коды и два вида уведомлений", "Защищённый API")
Rel(support, deposits, "Проверяет заявки и инициирует восстановление", "Защищённый интерфейс сопровождения")

Rel(rateStaff, rates, "Ведёт и публикует ставки")
Rel(visitor, site, "Смотрит предложения и оставляет обращение", "HTTPS")
Rel(site, rates, "Получает только общие предложения", "Защищённый API")
Rel(site, callCenter, "Передаёт заявку на обратный звонок", "Защищённый API")
Rel(callManager, callCenter, "Обрабатывает обращение и фиксирует условия")

SHOW_LEGEND()
@enduml