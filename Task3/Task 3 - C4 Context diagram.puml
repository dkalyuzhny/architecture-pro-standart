@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Открытие депозитов онлайн — C4 Context, MVP
SHOW_PERSON_OUTLINE()
LAYOUT_TOP_DOWN()

Person(client, "Клиент", "Действующий клиент интернет-банка (после идентификации в отделении банка)")
Person(visitor, "Посетитель сайта", "Существующие и новые клиенты")
Person(callManager, "Менеджер кол-центра", "Обрабатывает обращения")
Person(depositStaff, "Депозитный бэк-офис", "Подтверждает условия и открывает депозит")
Person(rateStaff, "Сотрудники бэк-офисов", "Депозитный и кредитный бэк-офисы")
Person(support, "Сотрудник сопровождения", "Контролирует незавершённые заявки")

Enterprise_Boundary(bank, "Банк «Стандарт»") {
    System(ib, "Интернет-банк", "Просмотр предложений, подача и сопровождение депозитной заявки")
    System_Ext(abs, "АБС", "Рассмотрение заявки, договор, счета и денежные операции")
    System_Ext(rates, "Реестр депозитных ставок", "Общие и персональные условия, версии и история")
    System_Ext(site, "Публичный сайт Банка", "Общие предложения и заявки на обратный звонок")
    System_Ext(callCenter, "Система кол-центра", "Обращения и предложенные условия")
    System_Ext(sms, "СМС-шлюз", "Доставка кодов подтверждения и уведомлений")
}

Rel(client, ib, "Просматривает предложения, подтверждает заявку, получает статус")
Rel(ib, abs, "Передаёт заявки; получает решения и результаты открытия", "Асинхронный обмен через интеграционный контур")
Rel(rates, ib, "Публикует общие и персональные условия")
Rel(ib, sms, "Инициирует отправку кодов и уведомлений")
Rel(depositStaff, abs, "Рассматривает заявку и открывает депозит")
Rel(rateStaff, rates, "Ведёт ставки в рамках полномочий")
Rel(support, ib, "Контролирует и восстанавливает обработку")

Rel(visitor, site, "Смотрит ставки, оставляет Ф. И. О. и телефон")
Rel(site, rates, "Получает общие действующие предложения")
Rel(site, callCenter, "Передаёт заявку на обратный звонок")
Rel(callManager, callCenter, "Обрабатывает обращение, фиксирует условия")

SHOW_LEGEND()
@enduml